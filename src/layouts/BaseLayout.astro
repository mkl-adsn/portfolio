---
import '../styles/global.css';
import ThemeToggle from '../components/ui/ThemeToggle.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}
const {
  title = 'Mikael Andersson — UX/UI Designer',
  description = 'Portfolio of Mikael Andersson, a senior UX/UI designer who aligns product vision with technical execution — case studies, CV, and contact details.',
  image = '/images/favicon/web-app-manifest-512x512.png',
  bodyClass,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class="no-transition">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <title>{title}</title>

    <!-- Applied before first paint so navigating between pages doesn't flash
         the wrong theme. Kept in sync by src/scripts/theme.ts.

         Falls back to the OS/browser `prefers-color-scheme` when the user
         hasn't clicked the toggle yet (no stored choice) — only an explicit
         click writes to localStorage, so this fallback keeps applying on
         every page load until they do.

         <html> starts with a `no-transition` class (transitions killed via
         base.css) so applying the stored theme here can't itself animate
         anything — without it, the vignette/background-color transitions
         would run on first paint, since this is the first time the browser
         resolves their style at all. Removed after two rAFs, i.e. once the
         first real frame has painted, so the toggle's *own* click still
         animates normally afterwards. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) {
            root.dataset.theme = 'dark';
          }
        } catch (e) {}
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            root.classList.remove('no-transition');
          });
        });
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mikael Andersson" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Figtree from Google Fonts; Warnock Pro loaded via @font-face in global.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['page-bg', 'scrollbar', bodyClass]}>
    <!-- Edge vignette, crossfaded between a light and dark gradient on theme
         change. Real sibling elements rather than .page-bg pseudo-elements
         so they can each fade via their own opacity without giving <body>
         a stacking context (see layout.css — that broke mix-blend-mode
         elsewhere, like the halftone case-image reveal). -->
    <div class="page-vignette page-vignette--light" aria-hidden="true"></div>
    <div class="page-vignette page-vignette--dark" aria-hidden="true"></div>

    <!-- Custom cursor: two images swapped on mousedown/up. Hidden on touch devices via CSS. -->
    <div id="custom-cursor" aria-hidden="true">
      <img class="cursor-default" src="/images/cursor/cursor-default.png" alt="" draggable="false" />
      <img class="cursor-pressed" src="/images/cursor/cursor-pressed.png" alt="" draggable="false" />
    </div>
    <ThemeToggle />
    <slot />
  </body>
</html>

<script>
  import { initCustomCursor } from '../scripts/cursor.ts';
  initCustomCursor();
</script>
