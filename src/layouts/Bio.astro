---
import { bioHeading, bioParagraphs } from '../content/data/bio.ts';
---

<section id="bio" class="py-12 md:py-24">
  <div class="zoom-in container flex gap-x-16 gap-y-4  lg:flex-row flex-col">

    <h2 class="draw-heading type-h1 min-w-1/2">
      {bioHeading}
    </h2>

    <div class="flex flex-col type-flow">
      {bioParagraphs.map(para => (
        <p class="type-body">{para}</p>
      ))}
    </div>

  </div>
</section>
