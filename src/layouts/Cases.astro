---
import { getCollection } from 'astro:content';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';

const allCases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="cases" class="py-12 md:py-24">
  <div class="container flex flex-col gap-32">
    {allCases.map((c, i) => {
      const isEven = i % 2 === 0;
      const orientation = c.data.imageOrientation ?? 'portrait';
      return (
        <article class={`zoom-in flex flex-col gap-4 lg:gap-16 lg:flex-row md:items-center  ${isEven ? '' : 'lg:flex-row-reverse'}`}>

          <!-- Case image -->
          <figure class={`case-image case-image--${orientation}`}>
            {c.data.image && (
              <img src={c.data.image} alt={c.data.title} class="draw-image" />
            )}
          </figure>
          <!-- Text block -->
          <div class="flex-1 flex flex-col gap-6 max-w-[600px]">
            <div class="flex flex-col gap-4">
              <div class="flex flex-col gap-2">
                <h2 class="draw-heading type-h2">{c.data.title}</h2>
                <div class="case-tags">
                  {c.data.tags.map(tag => (
                    <Tag label={tag} variant="light" />
                  ))}
                </div>
              </div>
              <p class="type-body">{c.data.description}</p>
            </div>
            <Button
              variant="light"
              href={c.data.comingSoon ? undefined : `/cases/${c.id.replace(/\.md$/, '')}`}
              disabled={c.data.comingSoon}
              class="self-start"
            >
              <span class="type-label">{c.data.comingSoon ? 'Coming soon' : 'View case'}</span>
            </Button>
          </div>

        </article>
      );
    })}
  </div>
 
</section>

<style>
  /* The halftone case images bleed -20px each side (see .halftone-figure-wrapper
     in animations.css) so their artwork — inset inside a transparent frame —
     lines up with the text column. At mobile the container padding is only 16px,
     so that bleed pokes 4px past the viewport → horizontal page scroll. Clip it
     here on the section (a plain block, unlike body/html whose overflow is
     subject to viewport-propagation quirks that let the scroll leak). The
     overhang is transparent frame, so clipping is visually lossless. */
  #cases {
    overflow-x: clip;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .case-image {
    flex-shrink: 0;
    margin: 0;
    overflow: hidden;
    z-index: 10;
    mix-blend-mode: multiply;
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Portrait: tall card, similar footprint to the old phone mockup */
  .case-image--portrait {
    width: 400px;
  }

  /* Landscape: wide card */
  .case-image--landscape {
    width: 720px;
  }

  @media (max-width: 1336px) {

    .case-image--landscape {
      width: 640px;
    }
    }

  @media (max-width: 767px) {
    .case-image--portrait {
      width: 100%;
     
      align-self: center;
    }

    .case-image--landscape {
      width: 100%;
    }
  }
</style>
