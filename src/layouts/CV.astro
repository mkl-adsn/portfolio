---
import SkillsFilter from '../components/ui/SkillsFilter.astro';
import { workExperience, education, languages } from '../content/data/cv.ts';
import Button from '../components/ui/Button.astro';
---

<section id="cv" class="py-12 md:py-24">

  <div class="container flex justify-between gap-x-8 gap-y-6 items-center flex-wrap mb-12 md:mb-24">
    <h2 class="type-h1 draw-heading">Curriculum Vitae</h2>
    <Button variant="light" icon="download" href="/cv.pdf" download>
      <span class="type-label">Download CV</span>
    </Button>
  </div>

  <div class="container-narrow flex flex-col gap-16 md:gap-24">

    <!-- Work Experience -->
    <div class="flex flex-col gap-12">
      <h3 class="draw-heading type-h2">Work Experience</h3>

      {workExperience.map(job => (
        <div class="zoom-in flex flex-col gap-6">
          <h4 class="draw-subheading type-h3">{job.company}, {job.period}</h4>
          <div class="flex flex-col type-flow">
            <p class="type-body-bold">{job.role}</p>
            {job.description.map(para => (
              <p class="type-body">{para}</p>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Skills -->
    <div class="flex flex-col gap-8 md:gap-12">
      <h3 class="draw-heading type-h2">Professional Skills</h3>

      <SkillsFilter />
    </div>

    <!-- Education -->
    <div class="flex flex-col gap-8 md:gap-12">
      <h3 class="draw-heading type-h2">Education</h3>

      {education.map(entry => (
        <div class="zoom-in flex flex-col gap-6">
          <h4 class="draw-subheading type-h3">{entry.institution}, {entry.period}</h4>
          <div class="flex flex-col type-flow">
            <p class="type-body-bold">{entry.degree}</p>
            <p class="type-body">{entry.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Languages -->
    <div class="flex flex-col gap-8 md:gap-12">
      <h3 class="draw-heading type-h2">Languages</h3>

      {languages.map(lang => (
        <div class="zoom-in flex flex-col gap-1">
          <p class="type-body-bold">{lang.name}</p>
          <p class="type-body cv-lang-level">{lang.level}</p>
        </div>
      ))}
    </div>

  </div>
</section>