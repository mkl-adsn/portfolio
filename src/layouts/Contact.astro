---
import { contacts } from '../content/data/contact.ts';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
---

<section id="contact" class="contact-section overflow-hidden mt-12">
  <div class="container-narrow py-32 md:py-60 flex flex-col gap-10">

    <h2 class="type-h2 type-on-dark"><strong>Get in touch</strong></h2>

    <div class="zoom-in flex flex-col gap-4">
      <h3 class="type-h3 type-on-dark">Mikael Andersson</h3>

      <ul class="list-none m-0 p-0 flex flex-col gap-4">
        {contacts.map(({ icon, label, href, external }) => (
          <li class="flex items-center gap-3">
            <Icon name={icon} tone="medium" />

            {href ? (
              <a
                href={href}
                class="type-body-bold type-on-dark no-underline hover:underline"
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            ) : (
              <span class="type-body-bold type-on-dark">{label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>

    <Button variant="light" icon="download" href="/cv.pdf" download class="self-start">
      <span class="type-label">Download CV</span>
    </Button>

  </div>
</section>

<style>
  .contact-section {
    background-color: var(--surface-9);
  }
</style>
