---
import Button from '../components/ui/Button.astro';
import { heroCopy } from '../content/data/hero';
---

<section id="hero" class="h-[100svh] md:h-[90svh] flex items-center">
  <div class="container flex flex-col gap-5 md:gap-10">

    <h1
      class="type-h1"
      aria-label={heroCopy}
    >
      <span id="hero-typewriter"></span><span class="hero-cursor" aria-hidden="true"></span>
    </h1>

    <div id="hero-buttons" class="flex gap-x-10 gap-y-4 items-center flex-wrap" style="opacity:0;">
      <Button variant="dark" href="#cases">
        <span class="type-label">Browse cases</span>
      </Button>
      <Button variant="light" icon="download" href="/cv.pdf" download>
        <span class="type-label">Download CV</span>
      </Button>
    </div>

  </div>
</section>
