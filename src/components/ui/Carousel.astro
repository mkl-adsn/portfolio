---
/**
 * Image carousel — arrows, drag/swipe, dots, and click-to-lightbox.
 * Arrows and dots are generated by src/scripts/carousel.ts (initCarousel);
 * this component only emits the slides.
 */
export interface Slide {
  src: string;
  alt?: string;
  caption?: string;
}
export interface Props {
  images: Slide[];
}
const { images } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="carousel__viewport">
    <div class="carousel__track">
      {images.map(({ src, alt = '', caption }) => (
        <figure class="carousel__slide">
          <img src={src} alt={alt} />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</div>

<!-- Styles: src/styles/components/carousel.css (loaded via global.css) -->
