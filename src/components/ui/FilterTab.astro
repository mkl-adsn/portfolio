---
export interface Props {
  label: string;
  filter: string;
  active?: boolean;
}

const { label, filter, active = false } = Astro.props;
---

<button
  type="button"
  role="radio"
  class="filter-tab"
  data-filter={filter}
  data-active={active ? 'true' : 'false'}
  aria-checked={active ? 'true' : 'false'}
  tabindex={active ? 0 : -1}
>
  <span class="filter-tab__label type-label-sm">{label}</span>
  <span class="filter-tab__bar"></span>
</button>

<!-- Styles: src/styles/components/filter-tab.css (loaded via global.css) -->
