---
export interface Props {
  label: string;
  filter: string;
  active?: boolean;
}

const { label, filter, active = false } = Astro.props;
---

<button
  class="filter-tab"
  data-filter={filter}
  data-active={active ? 'true' : 'false'}
>
  <span class="filter-tab__label type-label-sm">{label}</span>
  <span class="filter-tab__bar"></span>
</button>

<style>
  .filter-tab {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
  }

  .filter-tab__label {
    color: var(--grey-700);
    transition: color 120ms ease;
  }

    .filter-tab__label:hover {
    color: var(--grey-900);
  }

  .filter-tab__bar {
    display: block;
    width: 100%;
    height: 2px;
    background: transparent;
    transition: background 120ms ease;
  }

  /* Active state — driven by data-active attribute toggled from JS */
  .filter-tab[data-active='true'] .filter-tab__label { color: var(--grey-900); }
  .filter-tab[data-active='true'] .filter-tab__bar   { background: var(--grey-900); }
</style>
