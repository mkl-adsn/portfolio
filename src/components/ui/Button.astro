---
/**
 * Press-depth button — two variants, three states (default / hover / pressed).
 *
 * variant  'dark'  filled navy face, lighter navy edge
 *          'light' light face, grey border, dark grey edge
 *
 * icon     icon name from src/icons/ (without extension), e.g. "download"
 */
import Icon from './Icon.astro';
import type { IconName } from '../../scripts/icons';

export interface Props {
  variant?: 'dark' | 'light';
  icon?: IconName;
  href?: string;
  download?: boolean | string;
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'light',
  icon,
  href,
  download,
  disabled = false,
  class: className = '',
} = Astro.props;

// A disabled link can't use the native `disabled` attribute, so fall back to a
// <button> (which can) whenever the button is disabled.
const Tag = href && !disabled ? 'a' : 'button';

// Dark variant sits on a dark face → inverted (light) glyph.
// Light variant sits on a light face → strong glyph.
const iconTone = variant === 'dark' ? 'inverted' : 'strong';
---

<Tag
  href={href}
  download={download}
  disabled={Tag === 'button' && disabled}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={['btn', `btn--${variant}`, { 'btn--disabled': disabled }, className]}
>
  <span class="btn__face">
    {icon && <Icon name={icon} tone={iconTone} class="btn__icon" />}
    <slot />
  </span>
  <span class="btn__edge"></span>
</Tag>
<!-- Styles: src/styles/components/button.css (loaded via global.css) -->
