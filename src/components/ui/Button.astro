---
/**
 * Press-depth button — two variants, three states (default / hover / pressed).
 *
 * variant  'dark'  filled navy face, lighter navy edge
 *          'light' light face, grey border, dark grey edge
 *
 * icon     filename from /Images/Icon/ (without extension), e.g. "Download"
 */
export interface Props {
  variant?: 'dark' | 'light';
  icon?: string;
  href?: string;
  download?: boolean | string;
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'light',
  icon,
  href,
  download,
  disabled = false,
  class: className = '',
} = Astro.props;

// A disabled link can't use the native `disabled` attribute, so fall back to a
// <button> (which can) whenever the button is disabled.
const Tag = href && !disabled ? 'a' : 'button';

// Dark variant sits on a dark face → needs light (white) icon
// Light variant sits on a light face → needs dark icon
const iconSrc = icon
  ? variant === 'dark'
    ? `/images/Icon/Light/${icon}.svg`
    : `/images/Icon/Dark/${icon}.svg`
  : null;
---

<Tag
  href={href}
  download={download}
  disabled={Tag === 'button' && disabled}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={['btn', `btn--${variant}`, { 'btn--disabled': disabled }, className]}
>
  <span class="btn__face">
    {iconSrc && (
      <img
        src={iconSrc}
        width="24"
        height="24"
        alt=""
        class="btn__icon"
      />
    )}
    <slot />
  </span>
  <span class="btn__edge"></span>
</Tag>

<!-- Button styles live in global.css so they apply to any element using .btn classes -->
