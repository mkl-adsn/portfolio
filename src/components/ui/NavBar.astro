---
import { navItems } from '../../content/data/nav.ts';
---

<div class="nav-wrapper sticky top-0 z-100 flex justify-center pt-2 pointer-events-none">
  <nav id="main-nav" class="nav" aria-label="Page sections">
    {navItems.map(({ label, href }) => (
      <a
        href={href}
        class="nav__tab type-label-sm"
        data-section={href.slice(1)}
      >
        {label}
      </a>
    ))}
  </nav>
</div>

<style>
  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--grey-900);
    border-radius: 8px;
    background-color: rgba(249, 250, 251, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.15;
  mix-blend-mode: hard-light;  
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='turbulence' baseFrequency='0.65' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  filter: brightness(75%) contrast(120%) grayscale(0.8);
  background-size: 500px 500px;
}

  .nav__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 8px 16px;
    border-radius: 4px;
    color: var(--grey-900);
    text-decoration: none;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .nav__tab:hover        { background-color: var(--grey-900-006); }
  .nav__tab.active       { background-color: var(--grey-900); color: var(--grey-100); }
  .nav__tab.active:hover { background-color: var(--grey-800); }

</style>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.nav__tab');
  const sectionIds = Array.from(tabs).map(t => t.dataset.section!);

  const activate = (id: string) => {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.section === id));
  };

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) activate(id); },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
    ).observe(el);
  });

  tabs.forEach(tab => {
    tab.addEventListener('click', e => {
      e.preventDefault();
      document.getElementById(tab.dataset.section!)
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
