---
import { navItems } from '../../content/data/nav.ts';
---

<div class="nav-wrapper">
  <nav id="main-nav" class="nav" aria-label="Page sections">
    {navItems.map(({ label, href }) => (
      <a
        href={href}
        class="nav__tab type-label-sm"
        data-section={href.slice(1)}
      >
        {label}
      </a>
    ))}
  </nav>
</div>

<!-- Styles: src/styles/components/nav.css (loaded via global.css) -->

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.nav__tab');
  const sectionIds = Array.from(tabs).map(t => t.dataset.section!);

  const activate = (id: string) => {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.section === id));
  };

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) activate(id); },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
    ).observe(el);
  });

  tabs.forEach(tab => {
    tab.addEventListener('click', e => {
      e.preventDefault();
      document.getElementById(tab.dataset.section!)
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // ── Android URL-bar gap compensation ──────────────────────────────────────
  // The nav uses `position: sticky; top: 8px`, which pins to the *layout*
  // viewport. When Android's URL bar retracts, the *visual* viewport slides down
  // a few px (visualViewport.offsetTop) without moving the layout viewport, so
  // the 8px gap the user sees collapses. Re-add offsetTop to the sticky inset so
  // the *visible* gap stays 8px. offsetTop is 0 on desktop, so this is a no-op
  // there. Falls back to the CSS `top: 8px` if visualViewport is unavailable.
  const wrapper = document.querySelector<HTMLElement>('.nav-wrapper');
  const vv = window.visualViewport;
  if (wrapper && vv) {
    const GAP = 8;
    let queued = false;
    const sync = () => {
      queued = false;
      wrapper.style.top = `${GAP + vv.offsetTop}px`;
    };
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(sync);
    };
    vv.addEventListener('resize', schedule);
    vv.addEventListener('scroll', schedule);
    sync();
  }
</script>
