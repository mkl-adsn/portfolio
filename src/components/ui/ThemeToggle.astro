---
/**
 * Light/dark mode toggle — square, icon-only Button. Starts in light mode;
 * click behavior and glyph swapping (moon ↔ sun) live in src/scripts/theme.ts.
 */
import Icon from './Icon.astro';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Switch to dark mode"
  class="btn btn--light btn--icon-only theme-toggle"
>
  <span class="btn__face">
    <Icon name="moon" tone="strong" class="btn__icon" />
  </span>
  <span class="btn__edge"></span>
</button>

<!-- Styles: src/styles/components/button.css (.btn--icon-only) -->

<script>
  import { initThemeToggle } from '../../scripts/theme';
  initThemeToggle();
</script>

<style>
  /* Absolute (not fixed/sticky) — scrolls away with the page like the rest
     of the hero content. Positioned against <body>, which .page-bg makes a
     positioning context. */
  /* No z-index: as a positioned element it already paints above the static
     hero content, and the grain / nav / cursor sit above it via their own
     positive z-index tokens (so the grain textures the toggle too). */
  .theme-toggle {
    position: absolute;
    top: 16px;
    right: 16px;
  }
</style>
