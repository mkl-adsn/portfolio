---
import { skills } from '../../content/data/skills.ts';
import SkillTag from './SkillTag.astro';
import Button from './Button.astro';

const categories = ['All Skills', 'Application', 'Design', 'Code', 'Other', 'Irrelevant'];

const VISIBLE_DEFAULT = 8;
---

<div class="flex flex-col gap-6">
  <!-- Search box -->
  <div class="search-box">
    <div class="search-box__face">
      <img src="/images/Icon/Dark/Search.svg" width="24" height="24" alt="" class="flex-shrink-0" />
      <input
        id="skill-search"
        type="text"
        placeholder="Type to find skill..."
        class="search-box__input type-body"
        autocomplete="off"
      />
    </div>
    <div class="search-box__edge"></div>
  </div>

  <!-- Category filter tabs -->
  <div id="skill-filters" class="flex gap-6 items-end flex-wrap">
    {categories.map((cat, i) => (
      <button
        class="filter-btn flex flex-col gap-1 items-start cursor-pointer bg-transparent border-none p-0"
        data-filter={cat === 'All Skills' ? 'all' : cat}
        data-active={i === 0 ? 'true' : 'false'}
      >
        <span
          class="filter-label type-label"
          style={`color: ${i === 0 ? 'var(--grey-900)' : 'var(--grey-600)'};`}
        >
          {cat}
        </span>
        <span
          class="filter-bar w-full"
          style={`display: block; height: 2px; background: ${i === 0 ? 'var(--grey-900)' : 'transparent'};`}
        ></span>
      </button>
    ))}
  </div>

  <!-- Skill tags grid -->
  <div id="skills-grid" class="flex flex-wrap gap-2">
    {skills.map(skill => (
      <SkillTag name={skill.name} level={skill.level} categories={skill.categories} />
    ))}
  </div>

  <!-- Show all button — hidden until JS determines it's needed -->
  <div id="show-all-wrap" style="display: none;">
    <button id="show-all-btn" class="btn btn--light">
      <span class="btn__face">
        <span class="type-label">Show all skills</span>
      </span>
      <span class="btn__edge"></span>
    </button>
  </div>
</div>

<script>
  const VISIBLE_DEFAULT = 8;

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('skill-search') as HTMLInputElement;
    const filterBtns  = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const tags        = Array.from(document.querySelectorAll<HTMLElement>('.skill-tag'));
    const showAllWrap = document.getElementById('show-all-wrap')!;
    const showAllBtn  = document.getElementById('show-all-btn')!;

    let activeFilter = 'all';
    let searchQuery  = '';
    let showAll      = false;

    const applyFilters = () => {
      // Build ordered list of tags that match current filter + search
      const matching: HTMLElement[] = [];
      tags.forEach(tag => {
        const cats = (tag.dataset.categories ?? '').split(',');
        const nm   = tag.dataset.name ?? '';
        if (
          (activeFilter === 'all' || cats.includes(activeFilter)) &&
          nm.includes(searchQuery)
        ) {
          matching.push(tag);
        }
      });

      // Show/hide each tag
      tags.forEach(tag => {
        const rank = matching.indexOf(tag);
        tag.style.display =
          rank === -1 ? 'none'                          // filtered out
          : showAll || rank < VISIBLE_DEFAULT ? ''      // within cap or expanded
          : 'none';                                     // beyond cap
      });

      // Show button only when there are hidden-by-cap tags
      showAllWrap.style.display =
        !showAll && matching.length > VISIBLE_DEFAULT ? '' : 'none';
    };

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.filter ?? 'all';
        showAll = false;

        filterBtns.forEach(b => {
          const active = b === btn;
          b.querySelector<HTMLElement>('.filter-label')!.style.color =
            active ? 'var(--grey-900)' : 'var(--grey-600)';
          b.querySelector<HTMLElement>('.filter-bar')!.style.background =
            active ? 'var(--grey-900)' : 'transparent';
          b.dataset.active = active ? 'true' : 'false';
        });

        applyFilters();
      });
    });

    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      showAll = false;
      applyFilters();
    });

    showAllBtn.addEventListener('click', () => {
      showAll = true;
      applyFilters();
    });

    applyFilters();
  });
</script>

<style>
  /* ── Search box ──────────────────────────────────────────────────────────── */
  .search-box {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .search-box__face {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background-color: var(--grey-100);
    border: 1px solid var(--grey-900);
    border-radius: 4px;
    margin-bottom: -4px;
    position: relative;
    z-index: 2;
    transition: background-color 120ms ease, transform 120ms ease;
  }

  /* Active: face darkens and lifts 3px */
  .search-box:focus-within .search-box__face {
    background-color: var(--grey-200);
    transform: translateY(3px);
  }

  .search-box__edge {
    height: 8px;
    background-color: var(--grey-200);
    border-width: 0 1px 1px 1px;
    border-style: solid;
    border-color: var(--grey-600);
    border-radius: 0 0 4px 4px;
    position: relative;
    z-index: 1;
  }

  .search-box__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--grey-900);
    min-width: 0;
  }

  .search-box__input::placeholder {
    color: var(--grey-600);
  }
</style>
