---
import { skills } from '../../content/data/skills.ts';
import SkillTag from './SkillTag.astro';
import FilterTab from './FilterTab.astro';

const categories = ['All Skills', 'Application', 'Design', 'Dev', 'Other'];
const VISIBLE_DEFAULT = 8;
---

<div class="flex flex-col gap-4">

  <!-- Search box -->
  <div class="search-box">
    <label for="skill-search" class="sr-only">Search skills</label>
    <div class="search-box__face">
      <img src="/images/icon/dark/search.svg" width="24" height="24" alt="" class="flex-shrink-0" />
      <input
        id="skill-search"
        type="text"
        placeholder="Type to find skill..."
        class="search-box__input type-body"
        autocomplete="off"
      />
    </div>
    <div class="search-box__edge"></div>
  </div>

  <!-- Announces the filtered count to screen readers; visually hidden -->
  <p id="skills-status" class="sr-only" role="status" aria-live="polite"></p>

  <!-- Category filter tabs -->
  <div id="skill-filters" class="flex gap-x-6 gap-y-4 items-end flex-wrap mb-2">
    {categories.map((cat, i) => (
      <FilterTab
        label={cat}
        filter={cat === 'All Skills' ? 'all' : cat}
        active={i === 0}
      />
    ))}
  </div>

  <!-- Skill tags -->
  <div id="skills-grid" class="flex flex-wrap gap-2">
    {skills.map(skill => (
      <SkillTag name={skill.name} level={skill.level} categories={skill.categories} />
    ))}
  </div>

  <!-- Show-all button — hidden until JS determines it's needed -->
  <div id="show-all-wrap" style="display: none;">
    <button id="show-all-btn" class="btn btn--light">
      <span class="btn__face">
        <span class="type-label">Show all skills</span>
      </span>
      <span class="btn__edge"></span>
    </button>
  </div>

</div>

<script>
  const VISIBLE_DEFAULT = 8;

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('skill-search') as HTMLInputElement;
    const filterTabs  = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const tags        = Array.from(document.querySelectorAll<HTMLElement>('.skill-tag'));
    const showAllWrap = document.getElementById('show-all-wrap')!;
    const showAllBtn  = document.getElementById('show-all-btn')!;
    const status      = document.getElementById('skills-status')!;

    let activeFilter = 'all';
    let searchQuery  = '';
    let showAll      = false;

    function applyFilters() {
      const matching: HTMLElement[] = [];

      tags.forEach(tag => {
        const cats = (tag.dataset.categories ?? '').split(',');
        const name = tag.dataset.name ?? '';
        const matchesFilter = activeFilter === 'all' || cats.includes(activeFilter);
        const matchesSearch = name.includes(searchQuery);
        if (matchesFilter && matchesSearch) matching.push(tag);
      });

      tags.forEach(tag => {
        const rank = matching.indexOf(tag);
        tag.style.display = rank === -1 || (!showAll && rank >= VISIBLE_DEFAULT) ? 'none' : '';
      });

      showAllWrap.style.display = !showAll && matching.length > VISIBLE_DEFAULT ? '' : 'none';

      status.textContent = `${matching.length} skill${matching.length === 1 ? '' : 's'} shown`;
    }

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        activeFilter = tab.dataset.filter ?? 'all';
        showAll = false;

        // CSS handles the visual update via [data-active] attribute selectors
        filterTabs.forEach(t => {
          const isActive = t === tab;
          t.dataset.active = isActive ? 'true' : 'false';
          t.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        applyFilters();
      });
    });

    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      showAll = false;
      applyFilters();
    });

    showAllBtn.addEventListener('click', () => {
      showAll = true;
      applyFilters();
    });

    applyFilters();
  });
</script>

<!-- Styles: src/styles/components/search-box.css (loaded via global.css) -->
