---
import Icon from './Icon.astro';
import type { IconName } from '../../scripts/icons';

export interface Props {
  name: string;
  level: 1 | 2 | 3;
  categories: string[];
}
const { name, level, categories } = Astro.props;

// The pill is always dark (surface-9) → inverted (light) star glyphs.
const stars: IconName[] = [1, 2, 3].map(i => (i <= level ? 'star-filled' : 'star-outline'));
---

<div
  class="skill-tag"
  data-categories={categories.join(',')}
  data-name={name.toLowerCase()}
>
  <span class="skill-tag__name">
    {name}
    <span class="sr-only">, proficiency {level} of 3</span>
  </span>
  <span class="skill-tag__stars" aria-hidden="true">
    {stars.map(name => (
      <Icon name={name} tone="inverted" size={16} />
    ))}
  </span>
</div>

<!-- Styles: src/styles/components/skill-tag.css (loaded via global.css) -->
