---
export interface Props {
  name: string;
  level: 1 | 2 | 3;
  categories: string[];
}
const { name, level, categories } = Astro.props;

// Light folder = white icons for use on dark (grey-900) background
const STAR_FILLED  = '/images/icon/light/star-filled.svg';
const STAR_OUTLINE = '/images/icon/light/star-outline.svg';

const stars = [1, 2, 3].map(i => (i <= level ? STAR_FILLED : STAR_OUTLINE));
---

<div
  class="skill-tag"
  data-categories={categories.join(',')}
  data-name={name.toLowerCase()}
>
  <span class="skill-tag__name">
    {name}
    <span class="sr-only">, proficiency {level} of 3</span>
  </span>
  <span class="skill-tag__stars" aria-hidden="true">
    {stars.map(src => (
      <img src={src} width="16" height="16" alt="" />
    ))}
  </span>
</div>

<!-- Styles: src/styles/components/skill-tag.css (loaded via global.css) -->
