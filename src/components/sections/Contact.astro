---
import { contacts } from '../../content/data/contact.ts';
---

<section id="contact" class="contact-section overflow-hidden">
  <div class="container-narrow py-60 flex flex-col gap-10">

    <h2 class="type-h2" style="color: var(--grey-100);">Get in touch</h2>

    <div class="zoom-in flex flex-col gap-4">
      <h3 class="type-h3" style="color: var(--grey-100);">Mikael Andersson</h3>

      <ul class="list-none m-0 p-0 flex flex-col gap-4">
        {contacts.map(({ icon, label, href, external }) => (
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 flex-shrink-0">
              <img
                class="contact-icon"
                src={`/images/Icon/Light/${icon}.svg`}
                width="24"
                height="24"
                alt=""
              />
            </span>

            {href ? (
              <a
                href={href}
                class="type-body-bold no-underline hover:underline"
                style="color: var(--grey-100);"
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            ) : (
              <span class="type-body-bold" style="color: var(--grey-100);">{label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .contact-section {
    background-color: var(--grey-900);
  }

  /* Convert white SVG → grey-700 (#525b6c):
     brightness(0) collapses white to black, then the chain tints to the target hue. */
  .contact-icon {
    filter: brightness(0) saturate(100%) invert(38%) sepia(14%) saturate(450%) hue-rotate(183deg) brightness(94%) contrast(89%);
  }
</style>
