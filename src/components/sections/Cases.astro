---
import { getCollection } from 'astro:content';
import Button from '../ui/Button.astro';

const allCases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="cases" class="py-12 md:py-24">
  <div class="container flex flex-col gap-32">
    {allCases.map((c, i) => {
      const isEven = i % 2 === 0;
      const orientation = c.data.imageOrientation ?? 'portrait';
      return (
        <article class={`zoom-in flex flex-col gap-16 lg:flex-row md:items-center md:gap-[120px] ${isEven ? '' : 'lg:flex-row-reverse'}`}>

          <!-- Case image -->
          <figure class={`case-image case-image--${orientation}`}>
            {c.data.image && (
              <img src={c.data.image} alt={c.data.title} class="draw-image" data-halftone-src={c.data.halftoneImage} />
            )}
          </figure>
          <!-- Text block -->
          <div class="flex-1 flex flex-col gap-6 max-w-[600px]">
            <div class="flex flex-col gap-4">
              <div class="flex flex-col gap-2">
                <h2 class="draw-heading type-h2">{c.data.title}</h2>
                <p class="type-body-bold">
                  {c.data.subtitle.split('//').flatMap((part, j, arr) => [
                    part.trim(),
                    j < arr.length - 1 && <span style="color: var(--accent); margin-inline: 4px;">{'//'}</span>
                  ])}
                </p>
              </div>
              <p class="draw-body type-body">{c.data.description}</p>
            </div>
            <Button variant="light" href={`/cases/${c.id.replace(/\.md$/, '')}`} class="self-start">
              <span class="type-label">View case</span>
            </Button>
          </div>

        </article>
      );
    })}
  </div>
 
</section>

<style>
  .case-image {
    flex-shrink: 0;
    margin: 0;
    overflow: hidden;
    z-index: 10;
    mix-blend-mode: multiply;
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Portrait: tall card, similar footprint to the old phone mockup */
  .case-image--portrait {
    width: 400px;
  }

  /* Landscape: wide card */
  .case-image--landscape {
    width: 600px;
  }

  @media (max-width: 767px) {
    .case-image--portrait {
      width: 100%;
     
      align-self: center;
    }

    .case-image--landscape {
      width: 100%;
    }
  }
</style>
