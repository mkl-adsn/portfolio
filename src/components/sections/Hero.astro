---
import Button from '../ui/Button.astro';
---

<section id="hero" class="h-[90dvh] flex items-center">
  <div class="container flex flex-col gap-10">

    <h1 class="draw-heading type-h1 max-w-[1200px]">
      <strong>Senior UX/UI Designer aligning product vision with technical execution.</strong>
      {' '}Brings together stakeholder input and development understanding to create{' '}
      <strong>scalable, buildable UI solutions.</strong>
    </h1>

    <div class="zoom-in flex gap-x-10 gap-y-4 items-center flex-wrap">
      <Button variant="dark" href="#cases">
        <span class="type-label">Browse cases</span>
      </Button>
      <Button variant="light" icon="Download" href="/cv.pdf" download>
        <span class="type-label">Download CV</span>
      </Button>
    </div>

  </div>
</section>
