---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/ui/NavBar.astro';
import Hero from '../layouts/Hero.astro';
import Cases from '../layouts/Cases.astro';
import Bio from '../layouts/Bio.astro';
import CV from '../layouts/CV.astro';
import Contact from '../layouts/Contact.astro';
---

<BaseLayout bodyClass="home-page">
  <!-- Hero (full viewport) -->
  <Hero />

  <!-- Floating nav — sits in a sticky wrapper that starts after hero -->
  <NavBar />

  <!-- Scrollable sections -->
  <main>
    <Cases />
    <Bio />
    <CV />
    <Contact />
  </main>
</BaseLayout>

<script>
  import { initAnimations, initHeroTypewriter } from '../scripts/animations.ts';
  initHeroTypewriter();
  initAnimations();
</script>
