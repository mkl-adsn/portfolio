---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/ui/NavBar.astro';
import Hero from '../components/sections/Hero.astro';
import Cases from '../components/sections/Cases.astro';
import Bio from '../components/sections/Bio.astro';
import CV from '../components/sections/CV.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <!-- Hero (full viewport) -->
  <Hero />

  <!-- Floating nav — sits in a sticky wrapper that starts after hero -->
  <NavBar />

  <!-- Scrollable sections -->
  <main>
    <Cases />
    <Bio />
    <CV />
    <Contact />
  </main>
</BaseLayout>

<script>
  import { initAnimations } from '../scripts/animations.ts';
  initAnimations();
</script>
