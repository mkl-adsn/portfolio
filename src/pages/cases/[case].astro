---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Tag from '../../components/ui/Tag.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map(c => ({
    params: { case: c.id.replace(/\.md$/, '') },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — Mikael Andersson`}
  description={entry.data.description}
  image={entry.data.image}
  bodyClass="case-page"
>

  <div class="case-hero">
    <div class="container">
      <div class="case-hero__back">
        <Button variant="light" href="/#cases" icon="arrow-left">
          <span class="type-label">Back</span>
        </Button>
      </div>

      <h1 class="case-hero__title">{entry.data.title}</h1>

      <div class="case-hero__tags">
        {entry.data.tags.map(tag => (
          <Tag label={tag} variant="dark" />
        ))}
      </div>

      {entry.data.description && (
        <p class="type-preamble case-hero__lead">{entry.data.description}</p>
      )}
    </div>
  </div>

  <div class="container-narrow case-content">
    <article class="case-body">
      <Content />
    </article>

    <div class="case-content__back">
      <Button variant="light" href="/#cases" icon="arrow-left">
        <span class="type-label">Back</span>
      </Button>
    </div>
  </div>

</BaseLayout>

<script>
  import { initAnimations } from '../../scripts/animations.ts';
  import { initLightbox } from '../../scripts/lightbox.ts';
  import { initCarousel } from '../../scripts/carousel.ts';

  // Markdown-generated and split-block headings don't carry the draw classes,
  // so tag them here before initAnimations() queries the DOM. h2 → grey-900
  // draw-heading, h3 → grey-700 draw-subheading (same as the landing page).
  document
    .querySelectorAll('.case-body h2, .case-split__text h2')
    .forEach(el => el.classList.add('draw-heading'));

  document
    .querySelectorAll('.case-body h3, .case-split__text h3')
    .forEach(el => el.classList.add('draw-subheading'));

  // Drop markdown `---` rules entirely — section spacing comes from CSS margins.
  document.querySelectorAll('.case-body hr').forEach(el => el.remove());

  initAnimations();
  initLightbox();
  initCarousel();
</script>

<style>
  /* ─── Hero ──────────────────────────────────────────────────────────────── */
  .case-hero {
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .case-hero__back {
    margin-bottom: 64px;
  }

  /* One-off display size, larger than any ramp style (bigger than .type-h1's
     60px) and used only for the case hero — intentionally local, not a shared
     type style. */
  .case-hero__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 80px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--type-primary);
    margin: 0 0 16px;
  }
@media (max-width: 767px) {
 .case-hero__title {
    font-size: 48px;
  }
  }
  /* Typography comes from .type-preamble; this handles layout only. */
  .case-hero__lead {
    margin: 0;
    max-width: 720px;
  }

  .case-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0 0 40px;
  }

  /* ─── Content ────────────────────────────────────────────────────────────── */
  .case-content {
    padding-top: 96px;
    padding-bottom: 120px;
  }

  .case-content__back {
    display: flex;
    justify-content: center;
    margin-top: 96px;
  }

  /* ─── Prose body ───────────────────────────────────────────────────────────
     Typography (fonts, colors) and rhythm (margins/gaps) for markdown-generated
     `.case-body` content live in styles/typography.css, shared with the rest
     of the site. Only page-specific, non-typographic rules stay here. */
  :global(.case-body img) {
    width: 100%;
    display: block;
  }

  /* ─── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .case-hero {
      padding-top: 16px;
      padding-bottom: 48px;
    }
    .case-hero__back { margin-bottom: 40px; }
    .case-hero__tags { margin-bottom: 32px; }
    .case-content { padding-top: 16px; padding-bottom: 80px; }
  }

  /* ─── Layout blocks (global — target markdown-generated HTML) ────────────── */
  /* Break out of the narrow prose column to a wider, centered area so the
     two-column splits and full images have room to breathe. */
  :global(.case-split),
  :global(.case-image-full) {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: min(1536px, calc(100vw - 192px));
    z-index: var(--z-foreground);
  }

  :global(.case-split) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    margin: 48px auto;
  }

  /* A split's media slot is an <img>, a <video>, or a .device-frame wrapper —
     all size the same: scale down to the column, capped at 60vh so a tall
     portrait screenshot can't outgrow the viewport. The intrinsic width/height
     attributes hold the box before the media loads. Direct children only, so
     the cap doesn't reach the media *inside* a .device-frame. */
  :global(.case-split > img),
  :global(.case-split > video) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 60vh;
    display: block;
  }

  /* A .device-frame is a block box whose height follows from its width via
     aspect-ratio, so max-height wouldn't shrink it — cap the *width* instead,
     at whatever makes the derived height land on the same 60vh. */
  :global(.case-split > .device-frame) {
    width: min(100%, calc(60vh * var(--frame-w) / var(--frame-h)));
    margin-inline: auto;
  }

  /* Body type comes from .type-body (typography.css, which lists this
     selector); layout + colour only here. */
  :global(.case-split__text) {
    display: flex;
    flex-direction: column;
    gap: 24px;
    color: var(--type-primary);
  }


  :global(.case-split--image-right > img),
  :global(.case-split--image-right > video),
  :global(.case-split--image-right > .device-frame) { order: 2; }
  :global(.case-split--image-right .case-split__text) { order: 1; }

  :global(.case-image-full) {
    margin: 80px auto;
  }

  :global(.case-image-full img) {
    width: 100%;
    display: block;
  }

  /* Type from .type-caption (typography.css); colour/alignment/spacing here. */
  :global(.case-image-full figcaption) {
    color: var(--type-tertiary);
    text-align: center;
    margin-top: 16px;
  }

  @media (max-width: 767px) {
    /* Drop the breakout — sit back in the normal column flow */
    :global(.case-split),
    :global(.case-image-full) {
      position: static;
      left: auto;
      transform: none;
      width: 100%;
      margin: 32px 0;
    }

    :global(.case-split) {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    :global(.case-split--image-right > img),
    :global(.case-split--image-right > video),
    :global(.case-split--image-right > .device-frame) { order: unset; }
    :global(.case-split--image-right .case-split__text) { order: unset; }
  }
</style>
