---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map(c => ({
    params: { slug: c.id.replace(/\.md$/, '') },
    props: { entry: c },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Mikael Andersson`}>
  <div class="container-narrow py-24">

    <div class="mb-12">
      <Button variant="light" href="/#cases">
        <span class="type-label">← Back</span>
      </Button>
    </div>

    <h1 class="type-h2 mb-4">{entry.data.title}</h1>

    <p class="type-body-bold mb-8" style="color: var(--grey-700);">
      {entry.data.subtitle}
    </p>

    <div class="flex flex-wrap gap-2 mb-12">
      {entry.data.tags.map(tag => (
        <span class="type-label-sm" style="
          padding: 8px 16px;
          background-color: var(--grey-900);
          color: var(--grey-100);
          border-radius: 4px;
        ">
          {tag}
        </span>
      ))}
    </div>

    <article class="type-body flex flex-col gap-4">
      <Content />
    </article>

  </div>
</BaseLayout>
